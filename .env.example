# 複製為 .env 後修改：cp .env.example .env

# ---------------------------------------------------------------- 啟動組合
# 不想每次打 -f / --profile，可以在這裡設定（取消註解其中一組）
# CPU + Ollama：
# COMPOSE_PROFILES=vlm
# GPU + Ollama：
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# COMPOSE_PROFILES=vlm
# GPU + JoyCaption（NSFW 資料集）：
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# COMPOSE_PROFILES=joycaption

# ---------------------------------------------------------------- 服務
APP_PORT=7870
# 設定後 /api 與 /mcp 都需要 Authorization: Bearer <API_KEY>（對外開放時務必設定）
API_KEY=
# 回傳給 LLM 的下載連結前綴，例如 http://192.168.1.10:7870
PUBLIC_BASE_URL=
# 「從網址匯入」是否允許內網位址
ALLOW_PRIVATE_URLS=0
# API / MCP 未指定語言時的預設語言：zh-TW | en | ja | ko | zh-CN
# （WebUI 會自動依瀏覽器語言切換，也可在右上角選擇）
DEFAULT_LANG=en

# ---------------------------------------------------------------- WD14 標註器
# SmilingWolf/wd-eva02-large-tagger-v3（最準） / wd-vit-large-tagger-v3 / wd-swinv2-tagger-v3 / wd-vit-tagger-v3（快）
WD14_MODEL=SmilingWolf/wd-eva02-large-tagger-v3
# auto | cpu | cuda
ORT_DEVICE=auto
# 同時處理的圖片數（使用遠端 VLM 時可調高）
TAG_CONCURRENCY=2
# 選填：Hugging Face token（提高下載速率）
HF_TOKEN=

# ---------------------------------------------------------------- 自然語言描述 (VLM)
# openai    : OpenAI 相容端點（Ollama / vLLM / LM Studio / OpenRouter / OpenAI）
# anthropic : Claude API
# none      : 停用
VLM_BACKEND=openai

# Ollama（docker compose --profile vlm）
VLM_BASE_URL=http://ollama:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=ollama

# JoyCaption（docker compose --profile joycaption，無審查，適合 NSFW）
# VLM_BASE_URL=http://joycaption:8000/v1
# VLM_MODEL=joycaption
# VLM_API_KEY=EMPTY
# JOYCAPTION_GPU_UTIL=0.7
# vLLM 映像檔與 transformers 版本（預設 v0.30.0 + 5.16.1，見 docker/joycaption.Dockerfile）
# JOYCAPTION_VLLM_IMAGE=vllm/vllm-openai:v0.30.0
# JOYCAPTION_TRANSFORMERS=5.16.1

# 主機上已經在跑的 Ollama / LM Studio
# VLM_BASE_URL=http://host.docker.internal:11434/v1

VLM_TIMEOUT=180

# ---------------------------------------------------------------- Civitai 雲端訓練
# 在 civitai.com → 帳號設定 → API Keys 建立金鑰。設定後專案頁會出現「☁ Civitai 訓練」，
# 送出訓練會扣你帳號的 Buzz（送出前會先試算並要求確認）。金鑰只留在伺服器端。
CIVITAI_API_KEY=

# A1111 / Forge：訓練紀錄的「→ A1111」按鈕把 LoRA 匯入 Forge 的 Lora 資料夾（需要 Forge Neo Chino 的 LoRA 匯入 API）
# Forge 跑在同一台主機時用 host.docker.internal；沒設定就不顯示這個按鈕
A1111_URL=
# 放在 Lora 資料夾裡的哪個子資料夾（空白 = Lora 資料夾本身）
A1111_LORA_SUBFOLDER=LoRA-Tag-Studio
# Forge 有開 --api-auth 時填 帳號:密碼
A1111_API_AUTH=

# Claude（VLM_BACKEND=anthropic；會拒絕描述露骨內容，NSFW 請用 JoyCaption）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
